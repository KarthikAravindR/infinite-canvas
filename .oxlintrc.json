{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "jsx-a11y"],
  "categories": { "correctness": "error", "suspicious": "warn" },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/react-in-jsx-scope": "error",
    // Style hint; fix changes the bundle.
    "unicorn/consistent-function-scoping": "off",
    // Style hint; fix changes the bundle.
    "typescript/no-unnecessary-template-expression": "off"
  },
  "overrides": [
    {
      // Tests use the automatic JSX runtime, and unchecked casts are acceptable in tests.
      "files": ["test/**"],
      "rules": {
        "react/react-in-jsx-scope": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      // React Compiler rules skip any function with a react-hooks/* disable. The two in
      // ReactInfiniteCanvasRenderer switch them off for that whole component, so this is inert there today.
      // In utils.ts the only hit is the unused useOnScreen hook. ScrollBar isn't detected as a component.
      // v4 restores coverage only once those disables are gone and ScrollBar is detected; removing this alone is not enough.
      "files": ["src/App.tsx", "src/helpers/utils.ts"],
      "rules": {
        "react/immutability": "off",
        "react/exhaustive-effect-dependencies": "off",
        "react/memo-dependencies": "off"
      }
    }
  ],
  "ignorePatterns": ["dist", "CHANGELOG.md", "docs/", "playground/"]
}
