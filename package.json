{
  "name": "react-infinite-canvas",
  "version": "3.4.1",
  "description": "An Infinite Canvas Component for React where you can place your component anywhere on the canvas with zoom in, zoom out and panning functionality. It also supports custom components to control the canvas.",
  "type": "module",
  "main": "./dist/react-infinite-canvas.umd.cjs",
  "module": "./dist/react-infinite-canvas.js",
  "types": "./dist/main.d.ts",
  "scripts": {
    "build": "vite build && npm run build:types",
    "dev": "vite",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:types": "tsc -p tsconfig.build.json && api-extractor run --local && node -e \"const fs=require('fs');fs.copyFileSync('dist/main.d.ts','dist/main.d.cts');fs.rmSync('dist/types',{recursive:true})\""
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/main.d.ts",
        "default": "./dist/react-infinite-canvas.js"
      },
      "require": {
        "types": "./dist/main.d.cts",
        "default": "./dist/react-infinite-canvas.umd.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": [
      "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "keywords": [
    "infinite",
    "canvas",
    "workflow",
    "diagram",
    "space",
    "react",
    "typescript",
    "css modules",
    "vite",
    "component",
    "integration"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "*.md",
    "dist"
  ],
  "author": "Karthik Aravind",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=17 <20",
    "react-dom": ">=17 <20"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.3",
    "@microsoft/api-extractor": "^7.60.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@types/d3-transition": "^3.0.9",
    "@types/react": ">=17 <20",
    "@types/react-dom": ">=17 <20",
    "@vitejs/plugin-react": "^6.2.1",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "esbuild": "^0.28.2",
    "semantic-release": "^24.2.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-css-injected-by-js": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KarthikAravindR/infinite-canvas.git"
  },
  "dependencies": {
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9"
  }
}
